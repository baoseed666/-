{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "app": { "type": "application", "root": ".", "entryFile": "main", "sourceRoot": "src" },
    "scraper": { "type": "application", "root": ".", "entryFile": "scraper/main", "sourceRoot": "." }
  }
}
