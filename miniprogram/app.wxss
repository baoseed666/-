/* ==================== 抠门大王 · Global Styles ==================== */
page {
  background: #0a0a0a;
  color: #ffffff;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', monospace;
  min-height: 100vh;
  /* CRT scanline overlay */
  background-image: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2rpx,
    rgba(0, 0, 0, 0.12) 2rpx,
    rgba(0, 0, 0, 0.12) 4rpx
  );
}

/* ── Typography ── */
.title-xl { font-size: 72rpx; font-weight: 900; letter-spacing: 6rpx; }
.title-lg  { font-size: 56rpx; font-weight: 800; letter-spacing: 4rpx; }
.title-md  { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.text-sm   { font-size: 26rpx; }
.text-xs   { font-size: 22rpx; }
.bold      { font-weight: 700; }
.mono      { font-family: 'Courier New', monospace; }
.tracking  { letter-spacing: 3rpx; }

/* ── Color tokens ── */
.text-gold   { color: #ffdd00; }
.text-green  { color: #00ff88; }
.text-red    { color: #ff4444; }
.text-blue   { color: #4488ff; }
.text-muted  { color: #888844; }
.text-dim    { color: #555533; }
.text-white  { color: #ffffff; }

/* ── Cards ── */
.card {
  background: #111100;
  border: 1rpx solid #333300;
  border-radius: 6rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-gold {
  background: #111100;
  border: 1rpx solid #ffdd00;
  border-radius: 6rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 0 16rpx rgba(255, 221, 0, 0.15);
}

.card-green {
  background: #001a0d;
  border: 1rpx solid #00ff88;
  border-radius: 6rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 0 16rpx rgba(0, 255, 136, 0.15);
}

.card-red {
  background: #1a0000;
  border: 1rpx solid #ff4444;
  border-radius: 6rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 0 16rpx rgba(255, 68, 68, 0.15);
}

/* ── Buttons ── */
.btn-primary {
  background: #ffdd00;
  color: #0a0a0a;
  font-weight: 900;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  border-radius: 4rpx;
  padding: 24rpx 0;
  text-align: center;
  display: block;
  border: none;
  box-shadow: 0 0 24rpx rgba(255, 221, 0, 0.4);
  width: 100%;
}
.btn-primary[disabled] {
  background: #333300;
  color: #555533;
  box-shadow: none;
}

.btn-outline {
  border: 2rpx solid #ffdd00;
  color: #ffdd00;
  background: transparent;
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  border-radius: 4rpx;
  padding: 18rpx 0;
  text-align: center;
  display: block;
}

.btn-ghost {
  border: 1rpx solid #333300;
  color: #888844;
  background: transparent;
  font-size: 26rpx;
  border-radius: 4rpx;
  padding: 16rpx 0;
  text-align: center;
  display: block;
}

/* ── HP / MP Bars ── */
.hp-bar-wrap  { background: #1a0000; border-radius: 4rpx; height: 16rpx; overflow: hidden; }
.hp-bar-fill  { height: 100%; background: linear-gradient(90deg, #cc2222, #ff4444); border-radius: 4rpx; }
.mp-pip       { display: inline-block; width: 20rpx; height: 16rpx; border-radius: 3rpx; margin-right: 4rpx; }
.mp-pip-on    { background: #4488ff; box-shadow: 0 0 8rpx rgba(68,136,255,0.8); }
.mp-pip-off   { background: #1a1a2a; }

/* ── Badges ── */
.badge {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  padding: 4rpx 12rpx;
  border-radius: 3rpx;
  border: 1rpx solid currentColor;
  font-weight: 700;
}
.badge-hell   { color: #ff4444; background: rgba(255,68,68,0.1); }
.badge-normal { color: #ffdd00; background: rgba(255,221,0,0.1); }
.badge-easy   { color: #00ff88; background: rgba(0,255,136,0.1); }
.badge-main   { color: #00ff88; background: rgba(0,255,136,0.08); }
.badge-side   { color: #ffdd00; background: rgba(255,221,0,0.08); }
.badge-hidden { color: #4488ff; background: rgba(68,136,255,0.08); }

/* ── Neon Glow utilities ── */
.glow-gold  { text-shadow: 0 0 12rpx rgba(255,221,0,0.8);  }
.glow-green { text-shadow: 0 0 12rpx rgba(0,255,136,0.8);  }
.glow-red   { text-shadow: 0 0 12rpx rgba(255,68,68,0.8);  }

/* ── Divider ── */
.divider { border: none; border-top: 1rpx solid #222200; margin: 24rpx 0; }

/* ── Layout helpers ── */
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-center  { display: flex; align-items: center; justify-content: center; }
.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
