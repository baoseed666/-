.container {
  padding: 32rpx 32rpx 80rpx;
}

.city-card {
  padding: 32rpx;
}

.city-title {
  font-size: 36rpx;
}

.city-stats {
  display: flex;
}

.city-stat {
  text-align: center;
  flex: 1;
}

.city-stat-val {
  font-size: 48rpx;
  font-weight: bold;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.rank-no {
  font-size: 36rpx;
  width: 64rpx;
  text-align: center;
  font-weight: bold;
  color: #666;
}

.rank-top {
  font-size: 44rpx;
}

.flex-1 {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  margin-bottom: 4rpx;
}

.rank-title-tag {
  font-size: 24rpx;
}

.rank-amount {
  font-size: 36rpx;
  font-weight: bold;
}

.empty {
  padding: 80rpx;
  text-align: center;
}

.text-center {
  text-align: center;
}
