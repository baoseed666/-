.container {
  padding: 32rpx;
  min-height: 100vh;
}

/* ── INPUT 阶段 ── */
.title-area {
  padding: 24rpx 0;
}

.page-title {
  font-size: 56rpx;
}

.page-sub {
  margin-top: 8rpx;
}

.example-label {
  margin-bottom: 8rpx;
}

.example-item {
  background: #1a1a1a;
  border-radius: 8rpx;
  padding: 16rpx;
  color: #aaa;
}

.textarea {
  width: 100%;
  background: #111;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  padding: 24rpx;
  color: #fff;
  font-size: 30rpx;
  min-height: 160rpx;
  box-sizing: border-box;
}

.placeholder {
  color: #444;
}

.text-right {
  text-align: right;
  margin-top: 8rpx;
}

.error-msg {
  color: #ff4444;
}

/* ── LOADING 阶段 ── */
.loading-phase {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-inner {
  text-align: center;
}

.loading-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.loading-text {
  font-size: 40rpx;
}

.loading-sub {
  margin-top: 16rpx;
}

/* ── PLAN_SELECT 阶段 ── */
.plans-phase {
  padding-top: 16rpx;
}

.mb-8 { margin-bottom: 8rpx; }
.mb-32 { margin-bottom: 32rpx; }

.plans-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  background: #111;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #333;
}

.plan-hell   { border-left-color: #ff3333; background: #140808; }
.plan-normal { border-left-color: #ffdd00; background: #111108; }
.plan-easy   { border-left-color: #00ff88; background: #081411; }

.plan-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.difficulty-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.badge-hell   { background: #3a0000; color: #ff3333; }
.badge-normal { background: #2a2200; color: #ffdd00; }
.badge-easy   { background: #002a15; color: #00ff88; }

.plan-title {
  font-size: 30rpx;
  flex: 1;
}

.plan-stats {
  display: flex;
  justify-content: space-between;
}

.plan-stat {
  text-align: center;
}

.plan-stat-val {
  font-size: 36rpx;
}

.plan-stat-label {
  margin-top: 4rpx;
}

.plan-select-btn {
  width: 100%;
  background: #ffdd00;
  color: #000;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 20rpx 0;
  border: none;
}

/* ── TASKS 阶段 ── */
.stats-row {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
}

.stat-item {
  text-align: center;
}

.stat-val {
  font-size: 40rpx;
}

.task-card {
  border-left: 4rpx solid #333;
  margin-bottom: 16rpx;
}

.task-main   { border-left-color: #ffdd00; }
.task-side   { border-left-color: #00ff88; }
.task-hidden { border-left-color: #cc44ff; background: #110a1a; }

.task-type-badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #2a2a2a;
  color: #aaa;
}

.task-type-badge.main   { background: #2a2200; color: #ffdd00; }
.task-type-badge.side   { background: #002a15; color: #00ff88; }
.task-type-badge.hidden { background: #1a0a2a; color: #cc44ff; }

.task-desc {
  font-size: 30rpx;
  line-height: 1.5;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  line-height: 1.6;
  color: #888;
}

/* ── 店铺推荐 ── */
.shop-rec-area {
  background: #1a1a1a;
  border-radius: 12rpx;
  padding: 16rpx;
}

.shop-rec-label {
  margin-bottom: 8rpx;
}

.shop-card { background: #141414; border: 1rpx solid #2a2a2a; border-radius: 8rpx; overflow: hidden; margin-top: 12rpx; }
.shop-main { display: flex; flex-direction: row; padding: 16rpx; gap: 16rpx; }
.shop-img-wrap { width: 96rpx; height: 96rpx; border-radius: 8rpx; overflow: hidden; background: #1e1e1e; flex-shrink: 0; }
.shop-img { width: 100%; height: 100%; }
.shop-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.shop-info { flex: 1; min-width: 0; }
.shop-row-top { display: flex; justify-content: space-between; align-items: flex-start; }
.shop-name { color: #ffffff; font-size: 26rpx; font-weight: bold; }
.shop-rating { font-size: 24rpx; }
.shop-addr { color: #666; font-size: 22rpx; }
.text-blue { color: #4fc3f7; }
.discount-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.discount-tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 4rpx; border: 1rpx solid rgba(0,255,136,0.4); color: #00ff88; background: rgba(0,255,136,0.08); }
.shop-price { font-size: 22rpx; }
.shop-actions { display: flex; flex-direction: row; border-top: 1rpx solid #2a2a2a; }
.shop-btn { flex: 1; text-align: center; padding: 16rpx 0; font-size: 22rpx; }
.btn-dianping { color: #f97316; }
.btn-meituan { color: #facc15; }
.btn-nav { color: #00ff88; }
.btn-douyin { color: #f472b6; }

/* ── 动作链接 ── */
.action-links {
  width: 100%;
}

.action-links-scroll {
  width: 100%;
  white-space: nowrap;
}

.action-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #1e1e1e;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  min-width: 120rpx;
}

.action-btn-label {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 6rpx;
}
