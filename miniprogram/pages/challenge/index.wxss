.container {
  padding: 32rpx;
  min-height: 100vh;
}

/* ── INPUT 阶段 ── */
.title-area {
  padding: 24rpx 0;
}

.page-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffdd00;
  letter-spacing: 4rpx;
  text-shadow: 0 0 16rpx rgba(255,221,0,0.5);
}

.page-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888844;
  letter-spacing: 2rpx;
}

.example-label {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #555533;
  letter-spacing: 2rpx;
}

.example-item {
  background: #0d0d00;
  border: 1rpx solid #2a2a00;
  border-radius: 4rpx;
  padding: 16rpx;
  color: #888844;
  font-size: 24rpx;
}

.textarea {
  width: 100%;
  background: #0d0d00;
  border: 1rpx solid #333300;
  border-radius: 6rpx;
  padding: 24rpx;
  color: #fff;
  font-size: 30rpx;
  min-height: 160rpx;
  box-sizing: border-box;
}
.textarea:focus {
  border-color: #ffdd00;
  box-shadow: 0 0 12rpx rgba(255,221,0,0.2);
}

.placeholder {
  color: #333300;
}

.text-right {
  text-align: right;
  margin-top: 8rpx;
}

.error-msg {
  color: #ff4444;
  font-size: 24rpx;
}

/* ── LOADING 阶段 ── */
.loading-phase {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-inner {
  text-align: center;
}

.loading-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  display: block;
}

.loading-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffdd00;
  letter-spacing: 3rpx;
  text-shadow: 0 0 16rpx rgba(255,221,0,0.6);
}

.loading-sub {
  font-size: 24rpx;
  color: #888844;
  margin-top: 16rpx;
  letter-spacing: 1rpx;
}

/* ── PLAN_SELECT 阶段 ── */
.plans-phase {
  padding-top: 16rpx;
}

.mb-8  { margin-bottom: 8rpx; }
.mb-32 { margin-bottom: 32rpx; }

.plans-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  border-radius: 6rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  background: #0d0d00;
}

.plan-hell   { border: 2rpx solid #ff4444; box-shadow: 0 0 16rpx rgba(255,68,68,0.15); }
.plan-normal { border: 2rpx solid #ffdd00; box-shadow: 0 0 16rpx rgba(255,221,0,0.15); }
.plan-easy   { border: 2rpx solid #00ff88; box-shadow: 0 0 16rpx rgba(0,255,136,0.15); }

.plan-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.difficulty-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 3rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: 1rpx solid currentColor;
}

.badge-hell   { color: #ff4444; background: rgba(255,68,68,0.1); }
.badge-normal { color: #ffdd00; background: rgba(255,221,0,0.1); }
.badge-easy   { color: #00ff88; background: rgba(0,255,136,0.1); }

.plan-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  flex: 1;
  letter-spacing: 1rpx;
}

.plan-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.plan-stat {
  text-align: center;
}

.plan-stat-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffdd00;
}

.plan-stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #555533;
  letter-spacing: 1rpx;
}

.plan-select-btn {
  width: 100%;
  background: #ffdd00;
  color: #0a0a0a;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  border-radius: 4rpx;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 0 20rpx rgba(255,221,0,0.35);
}

/* ── TASKS 阶段 ── */
.stats-row {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  background: #0d0d00;
  border: 1rpx solid #222200;
  border-radius: 6rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffdd00;
}

.task-card {
  background: #0d0d00;
  border: 1rpx solid #222200;
  border-radius: 6rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.task-main   { border-left: 4rpx solid #00ff88 !important; }
.task-side   { border-left: 4rpx solid #ffdd00 !important; }
.task-hidden { border-left: 4rpx solid #4488ff !important; background: #00001a; }

.task-type-badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 3rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: 1rpx solid currentColor;
}

.task-type-badge.main   { color: #00ff88; background: rgba(0,255,136,0.08); }
.task-type-badge.side   { color: #ffdd00; background: rgba(255,221,0,0.08); }
.task-type-badge.hidden { color: #4488ff; background: rgba(68,136,255,0.08); }

.task-desc {
  font-size: 30rpx;
  line-height: 1.5;
  color: #ffffff;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  line-height: 1.6;
  color: #888844;
  font-size: 26rpx;
}

/* ── 店铺推荐 ── */
.shop-rec-area {
  background: #0d0d00;
  border: 1rpx solid #222200;
  border-radius: 6rpx;
  padding: 16rpx;
}

.shop-rec-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #888844;
  letter-spacing: 1rpx;
}

.shop-card { background: #0a0a00; border: 1rpx solid #2a2a00; border-radius: 6rpx; overflow: hidden; margin-top: 12rpx; }
.shop-main { display: flex; flex-direction: row; padding: 16rpx; gap: 16rpx; }
.shop-img-wrap { width: 96rpx; height: 96rpx; border-radius: 6rpx; overflow: hidden; background: #1a1a00; flex-shrink: 0; }
.shop-img { width: 100%; height: 100%; }
.shop-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.shop-info { flex: 1; min-width: 0; }
.shop-row-top { display: flex; justify-content: space-between; align-items: flex-start; }
.shop-name { color: #ffffff; font-size: 26rpx; font-weight: 700; }
.shop-rating { font-size: 24rpx; color: #ffdd00; }
.shop-addr { color: #555533; font-size: 22rpx; }
.text-blue { color: #4488ff; }
.discount-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.discount-tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 3rpx; border: 1rpx solid rgba(0,255,136,0.4); color: #00ff88; background: rgba(0,255,136,0.08); }
.shop-price { font-size: 22rpx; color: #888844; }
.shop-actions { display: flex; flex-direction: row; border-top: 1rpx solid #1a1a00; }
.shop-btn { flex: 1; text-align: center; padding: 16rpx 0; font-size: 22rpx; }
.btn-dianping { color: #f97316; }
.btn-meituan  { color: #facc15; }
.btn-nav      { color: #00ff88; }
.btn-douyin   { color: #f472b6; }

/* ── 动作链接 ── */
.action-links {
  width: 100%;
}

.action-links-scroll {
  width: 100%;
  white-space: nowrap;
}

.action-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #0d0d00;
  border: 1rpx solid #2a2a00;
  border-radius: 6rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  min-width: 120rpx;
}

.action-btn-label {
  font-size: 22rpx;
  color: #888844;
  margin-top: 6rpx;
}
