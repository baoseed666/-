<view class="container">
  <view class="logo-area">
    <view class="logo text-gold">抠门大王</view>
    <view class="slogan text-muted text-sm">省钱达人养成计划</view>
  </view>

  <view class="form card">
    <view class="demo-tip text-sm">
      <text class="text-gold">演示模式：</text>
      <text class="text-muted">验证码固定 123456</text>
    </view>

    <view class="field">
      <view class="label text-muted text-sm">手机号</view>
      <view class="input-row">
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
        <button class="btn-sms {{smsSent ? 'btn-sms-sent' : ''}}" disabled="{{smsSent || phone.length < 11}}" bindtap="sendSms">
          {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <view class="field mt-24">
      <view class="label text-muted text-sm">验证码</view>
      <input
        class="input"
        type="number"
        maxlength="6"
        placeholder="6位验证码"
        placeholder-class="placeholder"
        value="{{code}}"
        bindinput="onCodeInput"
      />
    </view>

    <button class="btn-primary mt-32" disabled="{{loading}}" bindtap="login">
      {{loading ? '登录中...' : '立即登录'}}
    </button>

    <view class="divider mt-24">
      <text class="text-muted text-sm">或</text>
    </view>

    <button class="btn-demo mt-16" bindtap="demoLogin">⚡ 一键体验 Demo（无需后端）</button>
  </view>
</view>
