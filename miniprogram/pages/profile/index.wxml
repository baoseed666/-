<view class="container" wx:if="{{user}}">

  <!-- Header: avatar + name + rank -->
  <view class="profile-header card">
    <view class="avatar-area">
      <view class="avatar">{{avatarChar}}</view>
      <view class="user-info">
        <view class="username bold text-lg">{{user.nickname || '抠门玩家'}}</view>
        <view class="user-rank text-gold text-sm">{{user.rankTitle || '消费韭菜'}}</view>
      </view>
      <view class="points-badge">
        <view class="points-val text-gold bold">{{user.points || 0}}</view>
        <view class="points-label text-muted text-sm">积分</view>
      </view>
    </view>
  </view>

  <!-- Two stat cards -->
  <view class="stats-row mt-16">
    <view class="stat-card card">
      <view class="stat-icon text-green">💰</view>
      <view class="stat-card-title bold mb-16">省钱专家</view>
      <view class="stat-val text-green bold">¥{{user.totalSaved || 0}}</view>
      <view class="stat-label text-muted text-sm">累计节省</view>
      <view class="stat-sub text-muted text-sm mt-16">共{{totalChallenges}}次挑战</view>
    </view>
    <view class="stat-card card">
      <view class="stat-icon text-gold">🏆</view>
      <view class="stat-card-title bold mb-16">挑战记录</view>
      <view class="stat-val text-gold bold">{{recentCount}}</view>
      <view class="stat-label text-muted text-sm">近7日挑战</view>
      <view class="stat-sub text-muted text-sm mt-16">{{user.rankTitle || '消费韭菜'}}</view>
    </view>
  </view>

  <!-- Recent history -->
  <view class="history-section mt-32" wx:if="{{history.length}}">
    <view class="section-title bold mb-16">历史挑战</view>
    <view wx:for="{{history}}" wx:key="id" class="history-item card">
      <view class="history-left">
        <view class="history-desc">{{item.inputText}}</view>
        <view class="history-meta text-muted text-sm mt-16">
          <text wx:if="{{item.status === 'completed'}}" class="status-badge status-done">已完成</text>
          <text wx:elif="{{item.status === 'failed'}}" class="status-badge status-fail">未完成</text>
          <text wx:else class="status-badge status-active">进行中</text>
          <text class="ml-8">{{item.createdAt}}</text>
        </view>
      </view>
      <view class="history-right">
        <view class="history-saved text-green bold">+¥{{item.savedAmount || 0}}</view>
        <view class="history-pts text-gold text-sm mt-16">+{{item.pointsEarned || 0}}分</view>
      </view>
    </view>
  </view>

  <view class="empty-history mt-32" wx:if="{{!history.length}}">
    <view class="text-muted text-sm" style="text-align:center">还没有挑战记录，快去开始吧！</view>
  </view>

  <button class="btn-outline logout-btn mt-32" bindtap="logout">退出登录</button>
</view>

<view class="not-login" wx:if="{{!user}}">
  <view class="not-login-icon">🔒</view>
  <view class="not-login-text text-muted mt-16">请先登录查看个人资料</view>
  <button class="btn-primary mt-32" bindtap="goLogin">去登录</button>
</view>
