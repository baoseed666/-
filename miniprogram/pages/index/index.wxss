.container {
  padding: 48rpx 32rpx 160rpx;
  min-height: 100vh;
}

/* Header */
.header { margin-bottom: 56rpx; }

.logo-text {
  font-size: 88rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: #ffdd00;
  text-shadow: 0 0 20rpx rgba(255,221,0,0.6), 0 0 40rpx rgba(255,221,0,0.2);
  line-height: 1.1;
}

.tagline {
  font-size: 24rpx;
  color: #888844;
  letter-spacing: 4rpx;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.stats-bar {
  background: #0d0d00;
  border: 1rpx solid #222200;
  border-radius: 6rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
}

/* Agent Cards */
.agents { margin-bottom: 40rpx; }

.agent-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 28rpx;
  background: #0d0d00;
  border: 1rpx solid #2a2a00;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.agent-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4rpx;
  background: #ffdd00;
  box-shadow: 0 0 8rpx rgba(255,221,0,0.6);
}

.agent-icon {
  font-size: 56rpx;
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.agent-info { flex: 1; min-width: 0; }

.agent-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.agent-desc {
  font-size: 24rpx;
  color: #888844;
  letter-spacing: 1rpx;
}

.agent-arrow {
  font-size: 40rpx;
  color: #ffdd00;
  flex-shrink: 0;
}

/* Rank Bar */
.rank-bar {
  background: #0d0d00;
  border: 1rpx solid #2a2a00;
  border-radius: 6rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
